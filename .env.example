# Copy this file to .env before enabling production authentication.
# Do not commit the real .env file.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Local authentication uses revocable server-side sessions, not browser JWTs.
AUTH_MODE=local
# Set true only when the control plane is served over HTTPS.
COOKIE_SECURE=false

# Optional bearer token for Prometheus. Without it, /metrics requires a signed-in session.
METRICS_TOKEN=replace-with-a-long-random-metrics-token
