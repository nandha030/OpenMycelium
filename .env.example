# Copy this file to .env before enabling production authentication.
# Do not commit the real .env file.
OPENMYCELIUM_SITE_ID=OM-LOCAL
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Dedicated AES-256 key material for encrypted kubeconfigs. Use 32+ random characters.
CLUSTER_CREDENTIAL_KEY=replace-with-at-least-32-random-characters

# Local authentication uses revocable server-side sessions, not browser JWTs.
AUTH_MODE=local
# Set true only when the control plane is served over HTTPS.
COOKIE_SECURE=false

# Optional bearer token for Prometheus. Without it, /metrics requires a signed-in session.
METRICS_TOKEN=replace-with-a-long-random-metrics-token
PROMETHEUS_PUBLIC_URL=http://127.0.0.1:9090
GRAFANA_PUBLIC_URL=http://127.0.0.1:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-unique-grafana-password
# Dedicated bearer token used by native hardware-discovery agents.
AGENT_TOKEN=replace-with-a-long-random-agent-token

# Portable MCCL collective coordinator used by selected execution plans.
MCCL_COORDINATOR_SERVICE=mccl-coordinator
MCCL_COORDINATOR_PORT=29500
